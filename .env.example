# Required: the only directory that MCP tools may access.
WORKSPACE_ROOT=D:\\AI\\Develop\\SreAgent

# Bind locally by default. Put a reverse proxy or Secure MCP Tunnel in front of it.
MCP_HOST=127.0.0.1
MCP_PORT=8787

# Optional. Set this to the Maven executable you want the guarded command tool to use.
# MAVEN_COMMAND=D:\\maven\\apache-maven-3.6.0\\bin\\mvn.cmd

# Kubernetes diagnostics. Only these namespaces are exposed to the model.
KUBECTL_COMMAND=kubectl
K8S_ALLOWED_NAMESPACES=default

# Jenkins diagnostics. Keep credentials in local .env only.
# JENKINS_URL=http://127.0.0.1:8080
# JENKINS_USER=readonly-user
# JENKINS_TOKEN=replace-with-api-token
